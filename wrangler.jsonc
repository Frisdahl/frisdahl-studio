{
  "name": "frisdahl-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "hello@frisdahlstudio.dk",
    // Resend's shared sender until frisdahlstudio.dk is verified in Resend; then use "Frisdahl Studio <hello@frisdahlstudio.dk>".
    "CONTACT_FROM": "Frisdahl Studio <onboarding@resend.dev>"
  }
}
