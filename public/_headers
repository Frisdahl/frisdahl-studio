# Cloudflare static asset headers (copied to the site root by the build).
# index.html and the other pages are not listed, so they keep revalidating on every visit and a new
# deploy shows at once; the files below are cached by the browser.

# Vite's built scripts, styles and fonts carry a content hash in their names: they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, so a day, then the old copy is shown while a fresh one loads for the next visit.
/fonts/*
  Cache-Control: public, max-age=2592000
/_img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# Files inside a case's folder only: /cases/<slug> itself is a page and must keep revalidating.
/cases/:slug/:file
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
